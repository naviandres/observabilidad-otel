# Example environment for the OTel Collector deploy + application stack (copy to .env, never commit .env).
# Secrets (Grafana tokens, AWS keys) live in SSM Parameter Store, NOT here (docs/conventions.md).
# These names are the ones the AWS/ADOT config reads via ${env:...}.

# AWS region resolved by the ECS task; also used by the awsxray/awsemf/awscloudwatchlogs exporters.
AWS_REGION=us-east-1

# LOCAL-ONLY (decision 2026-10-11, PLAN D8): these are NOT consumed by docker-compose or
# otel-collector-local.yaml. Only consumer: deploy/collector/otel-collector-aws.yaml
# (Grafana Cloud exporters, ECS/#5). Populate only if Grafana Cloud is reactivated;
# keep empty for the local stack.
GRAFANA_PROM_URL=https://prometheus.example.com/api/prom
GRAFANA_PROM_AUTH=
GRAFANA_TEMPO_ENDPOINT=https://tempo.example.com
GRAFANA_TEMPO_AUTH=
GRAFANA_LOKI_ENDPOINT=https://loki.example.com/otlp
GRAFANA_LOKI_AUTH=

# Collector sampling / X-Ray toggle (docs/configuration.md).
OTEL_TRACES_XRAY=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- GCP (PLAN v2 dual-cloud; read by deploy/collector/otel-collector-gcp.yaml in #21) ---
# Project used by the googlecloud exporters (traces->Cloud Trace, logs->Cloud Logging,
# metrics->Cloud Monitoring). Where: console.cloud.google.com -> project settings.
GCP_PROJECT_ID=my-project-id
# Some googlecloud exporter configs and the `gcp` resourcedetection detector read
# GOOGLE_CLOUD_PROJECT; keep it equal to GCP_PROJECT_ID.
GOOGLE_CLOUD_PROJECT=my-project-id
# GCP region, no default (PLAN §3.6): us-central1 explicitly.
GCP_REGION=us-central1
# Path to the Service Account key JSON — LOCAL/CI ONLY, file lives OUTSIDE this repo.
# In GKE this is replaced by Workload Identity (no key files on pods, PLAN D2/#21).
# Never paste the JSON contents here.
GOOGLE_APPLICATION_CREDENTIALS=
# Cloud Trace export toggle — GCP mirror of OTEL_TRACES_XRAY (PLAN §3.4 C2):
# set false during the benchmark so Cloud Trace ingest stays ~$0.
OTEL_TRACES_CLOUDTRACE=true

# --- Application (service-a / service-b, read via os.getenv; compose ships defaults) ---
# Master switch: false = no exporters, no in-memory spans (A/B benchmark, PLAN §4.A).
OTEL_ENABLED=true
# OTLP/gRPC endpoint to the Collector; never hardcode a host (PLAN §1.C).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# deployment.environment resource attribute, normalised by the Collector (PLAN §2.A).
DEPLOYMENT_ENVIRONMENT=development
# service-a -> service-b HTTP dependency (compose default).
INVENTORY_SERVICE_URL=http://service-b:8001
# Per-service Postgres URL (compose sets its own; local dev creds only — real
# passwords live in SSM/Secret Manager, never here).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orders
# Standard OTel SDK vars, set per-service by docker-compose (reference):
#   OTEL_SERVICE_NAME=service-a | service-b
#   OTEL_RESOURCE_ATTRIBUTES=service.name=<name>
