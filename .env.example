# Example environment for the OTel Collector deploy (copy to .env, never commit .env).
# Secrets (Grafana tokens, AWS keys) live in SSM Parameter Store, NOT here (docs/conventions.md).
# These names are the ones the AWS/ADOT config reads via ${env:...}.

# AWS region resolved by the ECS task; also used by the awsxray/awsemf/awscloudwatchlogs exporters.
AWS_REGION=us-east-1

# Grafana Cloud OTLP/Prometheus endpoints + basic-auth (injected from SSM at deploy).
GRAFANA_PROM_URL=https://prometheus.example.com/api/prom
GRAFANA_PROM_AUTH=
GRAFANA_TEMPO_ENDPOINT=https://tempo.example.com
GRAFANA_TEMPO_AUTH=
GRAFANA_LOKI_ENDPOINT=https://loki.example.com/otlp
GRAFANA_LOKI_AUTH=

# Collector sampling / X-Ray toggle (docs/configuration.md).
OTEL_TRACES_XRAY=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
