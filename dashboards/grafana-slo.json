{
  "annotations": { "list": [] },
  "editable": true,
  "uid": "otel-lab-slo",
  "title": "OpenTelemetry SLO Dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "service-a,service-b",
        "current": { "text": "service-a", "value": "service-a" },
        "options": [
          { "text": "service-a", "value": "service-a", "selected": true },
          { "text": "service-b", "value": "service-b", "selected": false }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "lab",
        "current": { "text": "lab", "value": "lab" },
        "options": [
          { "text": "lab", "value": "lab", "selected": true }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tasa de peticiones por segundo (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_requests_total[1m])) by (service_name)",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia P95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "exemplar": true,
            "links": [
              {
                "title": "Traza de ${__field.labels.service_name} (Tempo)",
                "url": "explore?left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"traceql\",\"query\":\"{resource.service.name=\\\"${__field.labels.service_name}\\\"}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}",
                "internal": true
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, service_name)) * 1000",
          "legendFormat": "{{service_name}} - P95"
        }
      ]
    }
  ]
}
